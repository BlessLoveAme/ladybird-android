diff --git a/CMakeLists.txt b/CMakeLists.txt
index ff886075..adde3e0b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,10 @@
 cmake_minimum_required(VERSION 3.25)
 
+if (VCPKG_TARGET_ANDROID)
+    # vcpkg must chainload the NDK toolchain before project() enables C and C++.
+    include("UI/Android/vcpkg_android.cmake")
+endif()
+
 include("Meta/CMake/environment.cmake")
 
 # vcpkg flags depend on what linker we are using
diff --git a/Meta/CMake/check_for_dependencies.cmake b/Meta/CMake/check_for_dependencies.cmake
index db142b9b..d82e658b 100644
--- a/Meta/CMake/check_for_dependencies.cmake
+++ b/Meta/CMake/check_for_dependencies.cmake
@@ -1,6 +1,8 @@
 include_guard()
 
-find_package(PkgConfig REQUIRED)
+if (NOT WIN32 AND NOT ANDROID)
+    find_package(PkgConfig REQUIRED)
+endif()
 
 if (NOT WIN32 AND NOT ANDROID)
     pkg_check_modules(LIBEDIT REQUIRED IMPORTED_TARGET libedit)
diff --git a/Meta/CMake/vcpkg/android-triplet.cmake b/Meta/CMake/vcpkg/android-triplet.cmake
new file mode 100644
index 00000000..36cdbab1
--- /dev/null
+++ b/Meta/CMake/vcpkg/android-triplet.cmake
@@ -0,0 +1,11 @@
+# Ladybird Android uses static third-party libraries; only libc++ is shared in the APK.
+if (NOT VCPKG_TARGET_ANDROID)
+    message(FATAL_ERROR "Ladybird's Android triplets require VCPKG_TARGET_ANDROID=ON")
+endif()
+if (NOT ANDROID_ABI MATCHES "^(arm64-v8a|x86_64)$")
+    message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
+endif()
+set(VCPKG_CMAKE_SYSTEM_NAME Android)
+set(VCPKG_CMAKE_SYSTEM_VERSION 30)
+set(VCPKG_CRT_LINKAGE dynamic)
+set(VCPKG_LIBRARY_LINKAGE static)
diff --git a/Meta/CMake/vcpkg/android-triplets/arm64-android.cmake b/Meta/CMake/vcpkg/android-triplets/arm64-android.cmake
new file mode 100644
index 00000000..fae3f9d9
--- /dev/null
+++ b/Meta/CMake/vcpkg/android-triplets/arm64-android.cmake
@@ -0,0 +1,4 @@
+include(${CMAKE_CURRENT_LIST_DIR}/../android-triplet.cmake)
+set(VCPKG_TARGET_ARCHITECTURE arm64)
+set(VCPKG_MAKE_BUILD_TRIPLET "--host=aarch64-linux-android")
+set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DANDROID_ABI=arm64-v8a)
diff --git a/Meta/CMake/vcpkg/android-triplets/x64-android.cmake b/Meta/CMake/vcpkg/android-triplets/x64-android.cmake
new file mode 100644
index 00000000..686acee3
--- /dev/null
+++ b/Meta/CMake/vcpkg/android-triplets/x64-android.cmake
@@ -0,0 +1,4 @@
+include(${CMAKE_CURRENT_LIST_DIR}/../android-triplet.cmake)
+set(VCPKG_TARGET_ARCHITECTURE x64)
+set(VCPKG_MAKE_BUILD_TRIPLET "--host=x86_64-linux-android")
+set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DANDROID_ABI=x86_64)
diff --git a/Meta/CMake/vcpkg/generate_vcpkg_toolchain_variables.cmake b/Meta/CMake/vcpkg/generate_vcpkg_toolchain_variables.cmake
index 9729cfac..90614e2f 100644
--- a/Meta/CMake/vcpkg/generate_vcpkg_toolchain_variables.cmake
+++ b/Meta/CMake/vcpkg/generate_vcpkg_toolchain_variables.cmake
@@ -80,7 +80,9 @@ if (NOT DEFINED CACHE{VCPKG_TARGET_TRIPLET} AND NOT DEFINED CACHE{VCPKG_HOST_TRI
         set(os osx)
     elseif (os_name MATCHES "Windows")
         set(os windows)
-    elseif (os_name MATCHES "FreeBSD")
+    elseif (os_name MATCHES "Android")
+        set(os android)
+    elseif (os_name STREQUAL "FreeBSD")
         set(os freebsd)
     else()
         message(FATAL_ERROR "Unable to automatically detect os name for vcpkg, please set VCPKG_TARGET_TRIPLET manually")
@@ -93,7 +95,7 @@ if (NOT DEFINED CACHE{VCPKG_TARGET_TRIPLET} AND NOT DEFINED CACHE{VCPKG_HOST_TRI
     string(REPLACE "-triplets" "" triplet_path ${triplet_path})
     string(TOLOWER ${triplet_path} triplet_path)
     if (NOT triplet_path STREQUAL "distribution")
-        if (NOT os_name MATCHES "Windows") #NOTE: Windows defaults to dynamic linking
+        if (NOT os_name MATCHES "Windows|Android") # NOTE: Windows defaults to dynamic linking
             set(full_triplet "${full_triplet}-dynamic")
         endif()
     elseif (os_name MATCHES "Windows")
diff --git a/UI/Android/PORTING.md b/UI/Android/PORTING.md
index 0618bfdc..169e7746 100644
--- a/UI/Android/PORTING.md
+++ b/UI/Android/PORTING.md
@@ -21,7 +21,7 @@ No device/emulator is currently connected, so these runtime probes have not been
 
 `Meta/CMake/use_linker.cmake` used `CMAKE_LINKER_TYPE=LLD`, which CMake 3.31 rejects with the Android NDK toolchain. Android now takes the existing `-fuse-ld=lld` fallback, and the root configure advances past C/C++ compiler detection.
 
-The current Git `origin/master` tree has no `UI/Android` frontend, Android vcpkg chainload script, or Android vcpkg triplets. The earlier Android Gradle/JNI project in this branch is an independent native smoke harness, not an upstream Ladybird UI integration. A manual root configure currently stops at `find_package(PkgConfig REQUIRED)` because a vcpkg Android toolchain and installed dependency set have not yet been supplied. No complete AK/LibWeb root build has succeeded.
+The current Git `origin/master` tree has no `UI/Android` frontend, Android vcpkg chainload script, or Android vcpkg triplets. The Android Gradle/JNI project in this branch is an independent native smoke harness, not an upstream Ladybird UI integration. Root CMake skips host `PkgConfig` on Android and has an Android linker-type fallback. An Android vcpkg chainload and static arm64/x64 triplets are now present, and the vcpkg manifest resolver starts. The first blocker is the missing Windows host compiler: vcpkg's `x64-windows` host triplet reports `Unable to find a valid Visual Studio instance`. Attempts to install Visual Studio 2022 Build Tools via winget exited with code 87. No complete AK/LibWeb root build has succeeded.
 
 The next build work must configure the project's actual vcpkg manifest and target toolchain rather than inventing source lists. AK needs FastFloat, simdutf, zmij, mimalloc and LLVM libc headers. Cross-build tools/code generators must run on the host; target libraries must use the NDK/Bionic sysroot.
 
diff --git a/UI/Android/vcpkg_android.cmake b/UI/Android/vcpkg_android.cmake
new file mode 100644
index 00000000..9dfe921f
--- /dev/null
+++ b/UI/Android/vcpkg_android.cmake
@@ -0,0 +1,21 @@
+# Chainload Android NDK under vcpkg for native C/C++ cross-compilation.
+# The Gradle CMake invocation provides VCPKG_TARGET_ANDROID, ANDROID_NDK, ANDROID_ABI and VCPKG_ROOT.
+if (NOT VCPKG_TARGET_ANDROID)
+    message(FATAL_ERROR "Pass -DVCPKG_TARGET_ANDROID=ON for Android builds")
+endif()
+if (NOT DEFINED ANDROID_NDK OR NOT EXISTS "${ANDROID_NDK}/build/cmake/android.toolchain.cmake")
+    message(FATAL_ERROR "ANDROID_NDK must point to a complete Android NDK installation")
+endif()
+if (NOT DEFINED VCPKG_ROOT OR NOT EXISTS "${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
+    message(FATAL_ERROR "VCPKG_ROOT must point to the initialized vcpkg checkout")
+endif()
+if (ANDROID_ABI STREQUAL "arm64-v8a")
+    set(VCPKG_TARGET_TRIPLET "arm64-android" CACHE STRING "" FORCE)
+elseif (ANDROID_ABI STREQUAL "x86_64")
+    set(VCPKG_TARGET_TRIPLET "x64-android" CACHE STRING "" FORCE)
+else()
+    message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
+endif()
+set(VCPKG_HOST_TRIPLET "x64-windows" CACHE STRING "" FORCE)
+set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${ANDROID_NDK}/build/cmake/android.toolchain.cmake" CACHE STRING "" FORCE)
+set(CMAKE_TOOLCHAIN_FILE "${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake" CACHE STRING "" FORCE)
